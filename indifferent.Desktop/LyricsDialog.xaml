<Window x:Class="indifferent.Desktop.LyricsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текст песни — LRCLIB" Width="620" Height="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TrackLbl" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12">
                <Run Text="Найди свой трек на сайте:"/>
            </TextBlock>
            <TextBlock Margin="0,2,0,0">
                <Hyperlink x:Name="OpenSite" Foreground="{DynamicResource Accent}">lrclib.net — открыть поиск в браузере</Hyperlink>
            </TextBlock>
            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,6,0,0"
                       Text="...или вставь сюда ссылку со страницы песни:"/>
            <TextBox x:Name="UrlBox" Padding="6" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderSubtle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="SearchBtn" Content="Найти текст (API)" Padding="12,5" Margin="0,0,10,0"/>
                <Button x:Name="FromUrlBtn" Content="Забрать по ссылке" Padding="12,5"/>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="Results" Grid.Row="3" Margin="0,12,0,0" Background="Transparent"
                 BorderBrush="{DynamicResource BorderSubtle}" Foreground="{DynamicResource TextPrimary}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ApplyBtn" Content="Сохранить текст" Padding="14,6" Background="{DynamicResource Accent}" Foreground="White" Margin="0,0,10,0"/>
            <Button x:Name="CloseBtn" Content="Закрыть" Padding="14,6"/>
        </StackPanel>
    </Grid>
</Window>
