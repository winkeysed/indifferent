<Window x:Class="indifferent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="indifferent" Height="600" Width="900" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}">

    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Background" Value="{DynamicResource ProgressBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pill" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- шапка -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Button Style="{StaticResource Ghost}" Foreground="{DynamicResource TextPrimary}" Click="Logo_Click" Content="indifferent" FontWeight="Light" FontSize="15" Margin="16,0,0,0"/>
                <Button Style="{StaticResource Ghost}" DockPanel.Dock="Right" Click="Settings_Click" Content="настройки"/>
                <Button Style="{StaticResource Ghost}" DockPanel.Dock="Right" Click="Playlists_Click" Content="плейлисты"/>
            </DockPanel>
        </Border>

        <!-- welcome -->
        <StackPanel x:Name="WelcomePanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="indifferent" FontSize="56" FontWeight="Light" Foreground="{DynamicResource TextPrimary}">
                <Run Foreground="{DynamicResource Accent}" FontWeight="Bold" Text="."/>
            </TextBlock>
            <TextBlock x:Name="WelcomeHint" Text="музыка слушает тебя" Foreground="{DynamicResource TextSecondary}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,28"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource Ghost}" Click="GoPlay_Click" Content="Поехали" Background="{DynamicResource Accent}" Foreground="White" FontWeight="SemiBold" Padding="28,10" Margin="0,0,16,0"/>
                <Button Style="{StaticResource Pill}" Click="NewPlaylist_Welcome_Click" Content="Создать плейлист" Padding="20,10"/>
            </StackPanel>
        </StackPanel>

        <!-- плеер -->
        <Grid x:Name="PlayerPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="LyricsList" Grid.Column="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0" Margin="40,20,20,20"
                     HorizontalContentAlignment="Center" SelectionMode="Single"/>
            <TextBlock x:Name="NoLyricsHint" Grid.Column="0" Text="" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False"/>

            <Image x:Name="Character" Grid.Column="1" Stretch="Uniform" MaxHeight="400" HorizontalAlignment="Right" Margin="0,0,40,0"/>
        </Grid>

        <!-- плейлисты -->
        <Grid x:Name="PlaylistsPanel" Grid.Row="1" Visibility="Collapsed" Margin="40,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="PlaylistCards"/>
            </ScrollViewer>
            <Button Style="{StaticResource Pill}" Content="+ Новый плейлист" HorizontalAlignment="Right" VerticalAlignment="Top" Click="NewPlaylist_Click"/>
        </Grid>

        <!-- треки плейлиста -->
        <Grid x:Name="DetailPanel" Grid.Row="1" Margin="40,10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="DetailTitle" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,12"/>
            <ListBox x:Name="TrackList" Grid.Row="1" BorderThickness="0" Background="Transparent"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource Ghost}" Background="{DynamicResource Accent}" Foreground="White" Content="▶ Играть все" Click="PlayAll_Click" Margin="0,0,12,0"/>
                <Button Style="{StaticResource Pill}" Content="+ Добавить трек" Click="AddTrack_Click"/>
            </StackPanel>
        </Grid>

        <!-- нижняя панель -->
        <Border x:Name="BottomPanel" Grid.Row="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="24,10" Visibility="Collapsed">
            <StackPanel>
                <Slider x:Name="Progress" Height="18" VerticalAlignment="Center" Margin="0,0,0,6"
                        Thumb.DragStarted="SeekStart" Thumb.DragCompleted="SeekEnd"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="NpTitle" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock x:Name="NpArtist" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="Volume" Width="90" Maximum="1" ValueChanged="Volume_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TimeLbl" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource Ghost}" Content="⏮" Click="Prev_Click"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource Ghost}" Foreground="{DynamicResource TextPrimary}" Content="▶" FontSize="18" Margin="8,0" Click="Play_Click"/>
                        <Button Style="{StaticResource Ghost}" Content="⏭" Click="Next_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
